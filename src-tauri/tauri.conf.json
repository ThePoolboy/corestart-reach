{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Corestart Reach",
  "version": "0.1.1",
  "identifier": "io.github.thepoolboy.corestart-reach",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Corestart Reach",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Corestart Networks",
    "homepage": "https://www.corestart.network",
    "copyright": "Copyright © 2026 Corestart Networks. Licensed under GPL-3.0.",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "RDP and SSH connection manager",
    "longDescription": "Corestart Reach keeps your RDP and SSH connections and their credentials in one encrypted vault and opens them with one click.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "both" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2RDJFOEUyOUY4QzBCN0YKUldSL0M0eWY0dWpTTnBxakp2czZ3cnpQUzFqdEZOa3M3MFBQTHdqZ0t1QmFuSkU3Um12YUNnYUsK",
      "endpoints": ["https://github.com/ThePoolboy/corestart-reach/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
