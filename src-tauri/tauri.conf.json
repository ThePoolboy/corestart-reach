{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Corestart Reach",
  "version": "0.1.0",
  "identifier": "network.corestart.reach",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Corestart Reach",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "rpm", "deb"],
    "publisher": "Corestart Networks",
    "homepage": "https://www.corestart.network",
    "copyright": "Copyright © 2026 Corestart Networks. Licensed under GPL-3.0.",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "RDP and SSH connection manager",
    "longDescription": "Corestart Reach keeps your RDP and SSH connections and their credentials in one encrypted vault and opens them with one click.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": { "recommends": ["freerdp"] },
      "deb": { "recommends": ["freerdp3-x11 | freerdp2-x11"] }
    }
  }
}
